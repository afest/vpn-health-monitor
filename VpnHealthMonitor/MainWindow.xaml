<Window x:Class="VpnHealthMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VpnHealthMonitor.Converters"
        Title="VPN Health Monitor"
        Icon="Heart.ico"
        Height="760"
        MinHeight="650"
        Width="1120"
        MinWidth="980"
        Background="#F1F4F7"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:RatioConverter x:Key="HeightRatio" />

        <!-- Палитра. Единственный набор цветов приложения: серо-синяя база + цвета статусов,
             те же значения используются в code-behind для баннера и tray-иконки. -->
        <SolidColorBrush x:Key="InkBrush" Color="#22262C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5B6472" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SoftBrush" Color="#EEF2F5" />
        <SolidColorBrush x:Key="LineBrush" Color="#DCE2E8" />
        <SolidColorBrush x:Key="LineStrongBrush" Color="#C3CCD6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3A6EA5" />
        <SolidColorBrush x:Key="OkBrush" Color="#25844B" />
        <SolidColorBrush x:Key="WarnBrush" Color="#B07407" />
        <SolidColorBrush x:Key="AlertBrush" Color="#B4432D" />

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="CardTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style x:Key="CardSummaryText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- Карточка: белая плашка с рамкой, заменяет дефолтный GroupBox. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E1E7EC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F6F8" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter Property="Foreground" Value="#9AA3AD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Основное действие вкладки: заливка акцентом. -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#2F5C8C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33608F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2B5279" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F6F8" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter Property="Foreground" Value="#9AA3AD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Круглая кнопка-подсказка «?» и кнопка «⋯» с меню редких действий. -->
        <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6,3" />
        </Style>

        <!-- Заголовок колонки таблицы: плоский, без объёмной рамки WPF по умолчанию. -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="BorderBrush" Value="#EDF1F4" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Шапка сворачиваемой карточки. Кликается целиком, шеврон показывает состояние. -->
        <Style x:Key="CardHeaderToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Chevron"
                                           Text="&#x25B8;"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Text" Value="&#x25BE;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Сегмент переключателя «компактно / подробно». -->
        <Style x:Key="SegmentToggle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="12,4" Margin="1">
                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding Content}"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource InkBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource InkBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вкладки: подчёркивание вместо объёмного «конверта» WPF по умолчанию. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="14,8"
                                Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="StatusBanner"
                Grid.Row="0"
                Background="#606A76"
                CornerRadius="8"
                Padding="18"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="НЕИЗВЕСТНО"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold" />
                <TextBlock x:Name="StatusDescriptionText"
                           Text="Загрузи настройки и запусти проверку."
                           Foreground="#EEF2F5"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Старт мониторинга" Click="StartButton_Click" />
                <Button x:Name="StopButton" Content="Стоп мониторинга" Click="StopButton_Click" IsEnabled="False" />
                <Button x:Name="RunCheckButton" Content="Проверить сейчас" Click="RunCheckButton_Click" />
            </WrapPanel>
            <Button x:Name="MoreActionsButton"
                    Grid.Column="1"
                    Style="{StaticResource GlyphButton}"
                    Content="&#x22EF;"
                    ToolTip="Ещё действия: baseline, папка логов, экспорт CSV"
                    Click="MoreActionsButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="BaselineButton" Header="Текущий IP как baseline" Click="BaselineButton_Click" />
                        <MenuItem Header="Открыть папку логов" Click="OpenLogsButton_Click" />
                        <MenuItem Header="Export CSV" Click="ExportCsvButton_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="2">
            <TabItem Header="Сводка">
                <Grid x:Name="SummaryLayout" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.05*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Таблице событий гарантированы её строки: развёрнутый блок сверху
                             прокручивается внутри карточки, а не выталкивает таблицу из окна. -->
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <!-- Три блока свёрнуты по умолчанию: место отдано таблице событий.
                         В свёрнутой шапке остаётся то, ради чего в блок заглядывают, плюс
                         значок ⚠, если внутри блока появилась проблема. -->
                    <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,10,10" VerticalAlignment="Top">
                        <StackPanel>
                            <ToggleButton x:Name="NetworkCardToggle" Style="{StaticResource CardHeaderToggle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Текущая сеть" Style="{StaticResource CardTitleText}" />
                                        <TextBlock x:Name="NetworkSummaryText"
                                                   Style="{StaticResource CardSummaryText}"
                                                   Text="Проверка ещё не запускалась" />
                                    </StackPanel>
                                    <TextBlock x:Name="NetworkWarningBadge"
                                               Grid.Column="1"
                                               Text="&#x26A0;"
                                               FontSize="15"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource WarnBrush}"
                                               Visibility="Collapsed" />
                                </Grid>
                            </ToggleButton>

                            <ScrollViewer x:Name="NetworkCardBody"
                                          MaxHeight="{Binding ActualHeight, ElementName=MainTabs, Converter={StaticResource HeightRatio}, ConverterParameter=0.45}"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsChecked, ElementName=NetworkCardToggle, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="12,0,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource LabelText}" Text="Внешний IPv4" ToolTip="Публичный IPv4, который видят внешние сайты через текущую сеть или VPN." />
                                    <TextBlock x:Name="ExternalIpText" Style="{StaticResource ValueText}" Text="Неизвестно" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="Внешний IPv6" ToolTip="Публичный IPv6 через IPv6-only endpoint'ы, если проверка включена." />
                                    <TextBlock x:Name="ExternalIpv6Text" Style="{StaticResource ValueText}" Text="Выключено" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="Страна" ToolTip="Страна публичного IP по geo/API. Показывается полным названием, например Швеция." />
                                    <TextBlock x:Name="CountryText" Style="{StaticResource ValueText}" Text="Неизвестно" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="ASN / провайдер" ToolTip="Автономная система и владелец сети, к которой относится внешний IP." />
                                    <TextBlock x:Name="ProviderText" Style="{StaticResource ValueText}" Text="Неизвестно" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="Активный интерфейс / default route" ToolTip="Best-effort интерфейс Windows, через который сейчас идет основной IPv4-трафик." />
                                    <TextBlock x:Name="InterfaceText" Style="{StaticResource ValueText}" Text="Неизвестно" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="Результаты IP API" ToolTip="Что показал каждый внешний IP-сервис. Если IP разные, VPN или правила маршрутизации отдают разные egress-IP для разных сайтов." />
                                    <TextBlock x:Name="IpApiResultsText" Style="{StaticResource ValueText}" Text="Неизвестно" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="DNS-серверы" ToolTip="DNS-серверы, которые Windows видит на активных сетевых интерфейсах." />
                                    <TextBlock x:Name="DnsServersText" Style="{StaticResource ValueText}" Text="Неизвестно" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource LabelText}" Text="Ожидаемая страна" ToolTip="Ожидаемая страна VPN. Если пусто, страна не участвует в проверке риска утечки." />
                                    <TextBlock x:Name="ExpectedCountryText" Style="{StaticResource ValueText}" Text="Не задано" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="Ожидаемые IPv4" ToolTip="Разрешенный список публичных IPv4. Учитывается как риск только если включен чекбокс риска по IP." />
                                    <TextBlock x:Name="ExpectedIpText" Style="{StaticResource ValueText}" Text="Не задано" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="Ожидаемый VPN-интерфейс" ToolTip="Настраиваемый VPN-адаптер. Фактический активный интерфейс слева всегда читается из Windows и вручную не подменяется." />
                                    <TextBlock x:Name="ExpectedInterfaceText" Style="{StaticResource ValueText}" Text="Не задано" />
                                    <Button x:Name="ReconfigureRouteButton"
                                            Content="Настроить маршрут"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,10"
                                            Click="ReconfigureRouteButton_Click" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="Проверка маршрута" ToolTip="Проверка «риск по маршруту VPN» сравнивает текущий default route с ожидаемым интерфейсом. В режиме системного прокси маршрут не меняется никогда, и такая проверка ничего не гарантирует." />
                                    <TextBlock x:Name="RouteCheckText" Style="{StaticResource ValueText}" Text="Проверка маршрута выключена" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="Контроль реального VPN-выхода" ToolTip="В режиме без отдельного адаптера прямой выход можно заметить только по ожидаемой стране, разрешённому ASN/провайдеру или строгому списку IP." />
                                    <TextBlock x:Name="VpnExitControlText" Style="{StaticResource ValueText}" Text="Не настроен" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="Последняя успешная проверка" ToolTip="Время последней проверки, где удалось получить внешний IPv4." />
                                    <TextBlock x:Name="LastSuccessText" Style="{StaticResource ValueText}" Text="Никогда" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="Последняя смена IP" ToolTip="Когда приложение заметило смену внешнего IPv4 в текущем запуске." />
                                    <TextBlock x:Name="LastIpChangeText" Style="{StaticResource ValueText}" Text="Никогда" />
                                    <TextBlock Style="{StaticResource LabelText}" Text="Baseline" ToolTip="Сохраненная нормальная точка: внешний IPv4, страна и время установки baseline." />
                                    <TextBlock x:Name="BaselineText" Style="{StaticResource ValueText}" Text="Не задано" />
                                </StackPanel>
                            </Grid>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,10,10" VerticalAlignment="Top">
                        <StackPanel>
                            <ToggleButton x:Name="SessionCardToggle" Style="{StaticResource CardHeaderToggle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Статистика сессии" Style="{StaticResource CardTitleText}" />
                                        <TextBlock x:Name="SessionSummaryText"
                                                   Style="{StaticResource CardSummaryText}"
                                                   Text="00:00:00 · инцидентов 0" />
                                    </StackPanel>
                                    <TextBlock x:Name="SessionWarningBadge"
                                               Grid.Column="1"
                                               Text="&#x26A0;"
                                               FontSize="15"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource WarnBrush}"
                                               Visibility="Collapsed" />
                                </Grid>
                            </ToggleButton>

                            <ScrollViewer x:Name="SessionCardBody"
                                          MaxHeight="{Binding ActualHeight, ElementName=MainTabs, Converter={StaticResource HeightRatio}, ConverterParameter=0.45}"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsChecked, ElementName=SessionCardToggle, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="12,0,12,10">
                                <TextBlock Style="{StaticResource LabelText}" Text="Здоровое время" ToolTip="Сколько времени текущий запуск находится в здоровом статусе без проблем." />
                                <TextBlock x:Name="UptimeText" Style="{StaticResource ValueText}" Text="00:00:00" />
                                <TextBlock Style="{StaticResource LabelText}" Text="Инциденты" ToolTip="Сколько раз за текущий запуск начинался проблемный статус: риск утечки, нет интернета, проверка не удалась или сеть просела." />
                                <TextBlock x:Name="OutagesText" Style="{StaticResource ValueText}" Text="0" />
                                <TextBlock Style="{StaticResource LabelText}" Text="Время проблем" ToolTip="Суммарное время в проблемных статусах: нет интернета, риск утечки, сеть просела, проверка не удалась." />
                                <TextBlock x:Name="ProblemTimeText" Style="{StaticResource ValueText}" Text="00:00:00" />
                            </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" VerticalAlignment="Top">
                        <StackPanel>
                            <ToggleButton x:Name="QualityCardToggle" Style="{StaticResource CardHeaderToggle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Проверки качества" Style="{StaticResource CardTitleText}" />
                                        <TextBlock x:Name="QualitySummaryText"
                                                   Style="{StaticResource CardSummaryText}"
                                                   Text="ping н/д · HTTP неизвестно" />
                                    </StackPanel>
                                    <TextBlock x:Name="QualityWarningBadge"
                                               Grid.Column="1"
                                               Text="&#x26A0;"
                                               FontSize="15"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource WarnBrush}"
                                               Visibility="Collapsed" />
                                </Grid>
                            </ToggleButton>

                            <ScrollViewer x:Name="QualityCardBody"
                                          MaxHeight="{Binding ActualHeight, ElementName=MainTabs, Converter={StaticResource HeightRatio}, ConverterParameter=0.45}"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsChecked, ElementName=QualityCardToggle, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="12,0,12,10">
                                <TextBlock Style="{StaticResource LabelText}" Text="Средний ping (20 проверок)" ToolTip="Средняя задержка ICMP ping по последним 20 проверкам, если ping доступен." />
                                <TextBlock x:Name="PingText" Style="{StaticResource ValueText}" Text="н/д" />
                                <TextBlock Style="{StaticResource LabelText}" Text="Потери ping (20 проверок)" ToolTip="Процент потерь ICMP ping по последним 20 проверкам. Это качество сети, а не счетчик смены страны или выключения VPN." />
                                <TextBlock x:Name="PacketLossText" Style="{StaticResource ValueText}" Text="н/д" />
                                <TextBlock Style="{StaticResource LabelText}" Text="Доступность HTTP" ToolTip="Проверка обычной доступности интернета через несколько HTTP endpoint'ов." />
                                <TextBlock x:Name="HttpText" Style="{StaticResource ValueText}" Text="Неизвестно" />
                            </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="14,11,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Последние события"
                                           Style="{StaticResource CardTitleText}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="#E7ECF1"
                                        CornerRadius="8"
                                        Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="CompactViewRadio"
                                                     Style="{StaticResource SegmentToggle}"
                                                     GroupName="EventsView"
                                                     Content="Компактно"
                                                     IsChecked="True"
                                                     ToolTip="Время, статус, описание, страна, ping"
                                                     Checked="EventsViewRadio_Checked" />
                                        <RadioButton x:Name="DetailedViewRadio"
                                                     Style="{StaticResource SegmentToggle}"
                                                     GroupName="EventsView"
                                                     Content="Подробно"
                                                     ToolTip="То же плюс IPv4, IPv6 и потери"
                                                     Checked="EventsViewRadio_Checked" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ListView x:Name="EventsList" Margin="4,0,4,6" SizeChanged="EventsList_SizeChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Время" Width="78" DisplayMemberBinding="{Binding TimeText}" />
                                        <GridViewColumn Header="Статус" Width="140" DisplayMemberBinding="{Binding StatusText}" />
                                        <GridViewColumn x:Name="EventDescriptionColumn" Header="Описание" Width="620" DisplayMemberBinding="{Binding Description}" />
                                        <GridViewColumn x:Name="EventIpv4Column" Header="IPv4" Width="120" DisplayMemberBinding="{Binding IPv4}" />
                                        <GridViewColumn x:Name="EventIpv6Column" Header="IPv6" Width="140" DisplayMemberBinding="{Binding IPv6}" />
                                        <GridViewColumn Header="Страна" Width="110" DisplayMemberBinding="{Binding CountryText}" />
                                        <GridViewColumn Header="Ping" Width="72" DisplayMemberBinding="{Binding PingText}" />
                                        <GridViewColumn x:Name="EventLossColumn" Header="Потери" Width="72" DisplayMemberBinding="{Binding PacketLossText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Защищённые приложения">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Динамический статус прав видно всегда: он объясняет, почему кнопки не срабатывают.
                         Постоянное объяснение режима убрано под «?». -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                x:Name="AdminStatusBorder"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,7"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AdminStatusGlyph"
                                           Text="&#x25CF;"
                                           FontSize="13"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="AdminStatusText"
                                           Text="Права администратора: проверяю..."
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                        </Border>
                        <ToggleButton x:Name="ProtectionHelpToggle"
                                      Grid.Column="1"
                                      Width="34"
                                      Height="34"
                                      Cursor="Hand"
                                      ToolTip="Как работает режим «закрыто по умолчанию» и что делать, если пропал интернет">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource LineStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="17">
                                        <TextBlock Text="?"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SoftBrush}" />
                                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource SoftBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#FFF6E6"
                            BorderBrush="#E0C580"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,10"
                            Visibility="{Binding IsChecked, ElementName=ProtectionHelpToggle, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Режим «закрыто по умолчанию» для выбранных программ" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Text="Для выбранных .exe создаётся постоянное правило Windows Firewall, блокирующее их ПРЯМОЙ выход через физические адаптеры (Wi-Fi/Ethernet/Bluetooth). Через VPN (TUN-адаптер или системный прокси) они продолжают работать. Если VPN выключен — прямого выхода нет (fail-closed). Операции с правилами требуют прав администратора (UAC). Windows Firewall не умеет «разрешить ровно один VPN-адаптер»; в режиме системного прокси рабочими остаются только программы, которые этот прокси используют." />
                            <TextBlock x:Name="BlockedAdaptersText" Style="{StaticResource LabelText}" TextWrapping="Wrap"
                                       Margin="0,10,0,0" Text="Адаптеры блокировки: список появится после применения правил." />
                            <TextBlock Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#8A6D1F"
                                       Text="Пропал интернет? Нажми «Отключить защиту» — правила снимутся. Если приложение не открывается, запусти tools\remove-protection.bat из папки приложения: он сам попросит права администратора." />
                        </StackPanel>
                    </Border>

                    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                        <Button Content="Добавить программу" Click="AddAppButton_Click" />
                        <Button Content="Применить правила" Click="ApplyRulesButton_Click" />
                        <Button Content="Отключить защиту" Click="DisableProtectionButton_Click" />
                        <Button Content="Обновить статус" Click="RefreshProtectionButton_Click" />
                    </WrapPanel>

                    <Border Grid.Row="3" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Защищённые программы"
                                       Style="{StaticResource CardTitleText}"
                                       Margin="14,11,14,6" />
                            <ListView x:Name="ProtectedAppsList" Margin="4,0,4,6" MinHeight="200" SizeChanged="ProtectedAppsList_SizeChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="PathChanged">
                                                <Setter Property="Background" Value="#FBE4E0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                                <Setter Property="Background" Value="#FBE4E0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Программа" Width="170" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn x:Name="ProtectedPathColumn" Header="Путь" Width="330" DisplayMemberBinding="{Binding Path}" />
                                        <GridViewColumn Header="Статус" Width="175">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <!-- Цвет не единственное отличие: у каждого состояния свой знак,
                                                         он читается и на обесцвеченном скриншоте. -->
                                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding StatusHint}">
                                                        <StackPanel.Resources>
                                                            <Style x:Key="StatusCellText" TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
                                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Protected">
                                                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="RulesNotApplied">
                                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="FileNotFound">
                                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <TextBlock Text="{Binding StatusGlyph}"
                                                                   Style="{StaticResource StatusCellText}"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Width="18" />
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Style="{StaticResource StatusCellText}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Правила применены" Width="140" DisplayMemberBinding="{Binding AppliedText}" />
                                        <GridViewColumn Header="Действия" Width="300">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button Content="Обновить путь" Click="UpdatePathApp_Click"
                                                                Visibility="{Binding CanUpdatePath, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="{Binding ResolvedNewPath}"
                                                                Margin="0,0,6,0" Padding="10,3" MinHeight="26" />
                                                        <Button Content="Переустановить" Click="ReinstallApp_Click"
                                                                Margin="0,0,6,0" Padding="10,3" MinHeight="26" />
                                                        <Button Content="Удалить" Click="RemoveApp_Click"
                                                                Margin="0" Padding="10,3" MinHeight="26" />
                                                    </WrapPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="Настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,12,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="Интервал, сек" ToolTip="Пауза между автоматическими проверками при включенном мониторинге." />
                        <TextBox x:Name="IntervalTextBox" Grid.Row="0" Grid.Column="1" Text="5" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}" Text="Ожидаемая страна" ToolTip="Ожидаемая страна VPN. Можно писать полное название или код, например Швеция или SE." />
                        <TextBox x:Name="ExpectedCountryTextBox" Grid.Row="1" Grid.Column="1" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}" Text="Риск по стране" ToolTip="Если включено, другая страна относительно ожидаемой даст «РИСК УТЕЧКИ»." />
                        <CheckBox x:Name="CountryRiskCheckBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,12" IsChecked="True" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelText}" Text="Ожидаемые IPv4" ToolTip="Список разрешенных внешних IPv4 через пробел, запятую или с новой строки." />
                        <TextBox x:Name="ExpectedIpsTextBox"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 AcceptsReturn="True"
                                 MinHeight="72"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelText}" Text="Риск по IPv4" ToolTip="Если включено, IP вне списка ожидаемых IPv4 или запрещенная смена baseline IP даст «РИСК УТЕЧКИ»." />
                        <CheckBox x:Name="IpRiskCheckBox" Grid.Row="4" Grid.Column="1" Margin="0,4,0,12" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelText}" Text="Разрешить смену IP в стране" ToolTip="Если включено, смена IP при совпадающей стране будет предупреждением «IP ИЗМЕНИЛСЯ», а не «РИСК УТЕЧКИ»." />
                        <CheckBox x:Name="AllowIpChangesCheckBox" Grid.Row="5" Grid.Column="1" Margin="0,4,0,12" IsChecked="True" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelText}" Text="Режим VPN и интерфейс" ToolTip="Сначала выбери, создаёт ли VPN отдельный Windows-адаптер. В режиме с адаптером выбери его из списка; активный default route приложение читает само." />
                        <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
                            <ComboBox x:Name="RouteModeBox" SelectionChanged="RouteModeBox_SelectionChanged">
                                <ComboBoxItem Tag="SeparateAdapter" Content="VPN создаёт отдельный адаптер (TUN/TAP/WireGuard)" />
                                <ComboBoxItem Tag="NoSeparateAdapter" Content="VPN работает без отдельного адаптера (proxy/WFP/redirect)" />
                            </ComboBox>
                            <ComboBox x:Name="ExpectedInterfaceBox"
                                      Margin="0,6,0,0"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      ToolTip="Выбери VPN-адаптер из списка Windows. Ручной ввод оставлен для нестандартных или скрытых адаптеров." />
                            <TextBlock x:Name="RouteModeHintText"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource LabelText}" Text="Риск по маршруту VPN" ToolTip="Если включено, уход default route с ожидаемого VPN-интерфейса даст «РИСК УТЕЧКИ», даже если IP API временно не ответили." />
                        <CheckBox x:Name="RouteRiskCheckBox" Grid.Row="7" Grid.Column="1" Margin="0,4,0,12" IsChecked="True" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource LabelText}" Text="IPv6 leak check" ToolTip="Если включено, приложение пробует получить внешний IPv6 через IPv6-only endpoint'ы." />
                        <CheckBox x:Name="Ipv6CheckBox" Grid.Row="8" Grid.Column="1" Margin="0,4,0,12" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource LabelText}" Text="Разрешить внешний IPv6" ToolTip="Если выключено и внешний IPv6 виден наружу, статус станет «РИСК УТЕЧКИ»." />
                        <CheckBox x:Name="AllowExternalIpv6CheckBox" Grid.Row="9" Grid.Column="1" Margin="0,4,0,12" IsChecked="True" />

                        <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource LabelText}" Text="IPv6/API endpoint'ы" ToolTip="IPv6-only сервисы для проверки внешнего IPv6." />
                        <TextBox x:Name="Ipv6ApiEndpointsTextBox"
                                 Grid.Row="10"
                                 Grid.Column="1"
                                 AcceptsReturn="True"
                                 MinHeight="72"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource LabelText}" Text="Enable DNS check" ToolTip="Если включено, приложение показывает DNS-серверы, которые видит Windows." />
                        <CheckBox x:Name="DnsCheckBox" Grid.Row="11" Grid.Column="1" Margin="0,4,0,12" IsChecked="True" />

                        <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource LabelText}" Text="Уведомления" ToolTip="Доставка Windows-балунов: главный переключатель плюс per-type фильтры шумных событий. Меняют только показ балуна — детект и tray-иконка работают всегда." />
                        <StackPanel Grid.Row="12" Grid.Column="1" Margin="0,4,0,12">
                            <CheckBox x:Name="WindowsNotificationsCheckBox" Content="Включить уведомления Windows" IsChecked="True"
                                      ToolTip="Главный выключатель. Если снят — балуны не показываются вообще." />
                            <CheckBox x:Name="NotifyCountryChangedCheckBox" Content="Уведомлять о смене страны (важно)" IsChecked="True" Margin="18,6,0,0"
                                      ToolTip="Ban-релевантный сигнал. По умолчанию включён." />
                            <CheckBox x:Name="NotifyIpChangedCheckBox" Content="Уведомлять о смене IP (шумно)" Margin="18,4,0,0"
                                      ToolTip="Внешний IP меняется часто и мало влияет на баны. По умолчанию выключен, чтобы не зашумлять важные алерты." />
                            <TextBlock Style="{StaticResource LabelText}" Margin="18,6,0,0" TextWrapping="Wrap"
                                       Text="Алерт «защита приложения не действует» (kill-switch) показывается всегда — это сигнал безопасности." />
                        </StackPanel>

                        <TextBlock Grid.Row="13" Grid.Column="0" Style="{StaticResource LabelText}" Text="Закрывать в трей" ToolTip="Если мониторинг запущен, закрытие окна спрячет его в tray, а не остановит мониторинг." />
                        <CheckBox x:Name="MinimizeToTrayCheckBox" Grid.Row="13" Grid.Column="1" Margin="0,4,0,12" IsChecked="True" />

                        <TextBlock Grid.Row="14" Grid.Column="0" Style="{StaticResource LabelText}" Text="IPv4/API endpoint'ы" ToolTip="Сервисы для получения внешнего IPv4 и geo. Используются с fallback, не один-единственный источник." />
                        <TextBox x:Name="IpApiEndpointsTextBox"
                                 Grid.Row="14"
                                 Grid.Column="1"
                                 AcceptsReturn="True"
                                 MinHeight="96"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Grid.Row="15" Grid.Column="0" Style="{StaticResource LabelText}" Text="Порог ping, ms" ToolTip="Порог среднего ping. Если выше, статус станет «СЕТЬ ПРОСЕЛА» при корректном IP." />
                        <TextBox x:Name="PingThresholdTextBox" Grid.Row="15" Grid.Column="1" Text="250" />

                        <TextBlock Grid.Row="16" Grid.Column="0" Style="{StaticResource LabelText}" Text="Порог потерь, %" ToolTip="Порог потерь ping. Если выше, статус станет «СЕТЬ ПРОСЕЛА» при корректном IP." />
                        <TextBox x:Name="LossThresholdTextBox" Grid.Row="16" Grid.Column="1" Text="5" />

                        <TextBlock Grid.Row="17" Grid.Column="0" Style="{StaticResource LabelText}" Text="Папка логов" ToolTip="Папка, куда сохраняются локальные JSONL-логи событий." />
                        <TextBox x:Name="LogsFolderTextBox" Grid.Row="17" Grid.Column="1" />

                        <TextBlock Grid.Row="18" Grid.Column="0" Style="{StaticResource LabelText}" Text="Автосохранение логов" ToolTip="Если включено, события мониторинга автоматически записываются в JSONL-файл." />
                        <CheckBox x:Name="AutosaveLogsCheckBox" Grid.Row="18" Grid.Column="1" Margin="0,4,0,12" IsChecked="True" />

                        <TextBlock Grid.Row="19" Grid.Column="0" Style="{StaticResource LabelText}" Text="Риск по провайдеру" ToolTip="Если включено, выход через провайдера вне списка разрешённых даст «РИСК УТЕЧКИ». Единственная проверка, которая работает, когда VPN выходит в твоей же стране: при обрыве туннеля провайдер становится домашним. Если список пуст или провайдер не определён — проверка молчит." />
                        <CheckBox x:Name="ProviderRiskCheckBox" Grid.Row="19" Grid.Column="1" Margin="0,4,0,12" />

                        <TextBlock Grid.Row="20" Grid.Column="0" Style="{StaticResource LabelText}" Text="Разрешённые провайдеры" ToolTip="Провайдеры, которые считаются «это по-прежнему мой VPN»: имя организации, ASN или «Имя (ASNxxxx)» — по одному в строке. Кнопка baseline добавляет текущего автоматически. Если VPN переключается между хостерами, добавь их все." />
                        <StackPanel Grid.Row="20" Grid.Column="1">
                            <TextBox x:Name="AllowedProvidersTextBox"
                                     AcceptsReturn="True"
                                     MinHeight="72"
                                     VerticalScrollBarVisibility="Auto" />
                            <Button Content="Добавить текущего провайдера" HorizontalAlignment="Left" Margin="0,6,0,12"
                                    Click="AddCurrentProviderButton_Click" />
                        </StackPanel>

                        <TextBlock Grid.Row="21" Grid.Column="0" Style="{StaticResource LabelText}" Text="HTTP-пробы доступности" ToolTip="Адреса, по которым проверяется «есть ли интернет вообще». Если в твоей сети заблокированы Google и Cloudflare — замени их на доступные. Пустое поле вернёт значения по умолчанию." />
                        <TextBox x:Name="HttpProbesTextBox"
                                 Grid.Row="21"
                                 Grid.Column="1"
                                 AcceptsReturn="True"
                                 MinHeight="72"
                                 VerticalScrollBarVisibility="Auto" />

                        <TextBlock Grid.Row="22" Grid.Column="0" Style="{StaticResource LabelText}" Text="Хосты для ping" ToolTip="Адреса для ICMP-проверки задержки и потерь. Пустое поле вернёт значения по умолчанию." />
                        <TextBox x:Name="PingHostsTextBox"
                                 Grid.Row="22"
                                 Grid.Column="1"
                                 AcceptsReturn="True"
                                 MinHeight="52"
                                 VerticalScrollBarVisibility="Auto" />

                        <StackPanel Grid.Row="23" Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" Click="SaveSettingsButton_Click" />
                            <Button Content="Перезагрузить настройки" Click="ReloadSettingsButton_Click" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="FooterText"
                   Grid.Row="3"
                   Text="Настройки: загрузка..."
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   Margin="0,8,0,0" />
    </Grid>
</Window>
