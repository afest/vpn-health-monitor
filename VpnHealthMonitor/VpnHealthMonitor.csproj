<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Heart.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Heart.ico" />
  </ItemGroup>

  <!-- T-324: аварийный скрипт снятия правил должен лежать РЯДОМ с exe — он нужен именно тогда,
       когда приложение не запускается, и искать его в исходниках человек не пойдёт. -->
  <ItemGroup>
    <Content Include="..\tools\remove-protection.ps1;..\tools\remove-protection.bat"
             Link="tools\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- T-182: grant the dev-only test project access to internal pure helpers (FirewallService.PathsMatch). -->
  <ItemGroup>
    <InternalsVisibleTo Include="VpnHealthMonitor.Tests" />
  </ItemGroup>

</Project>
