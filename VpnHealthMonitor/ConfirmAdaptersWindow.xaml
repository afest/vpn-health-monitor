<Window x:Class="VpnHealthMonitor.ConfirmAdaptersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Через какие адаптеры блокировать прямой выход"
        Width="660" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10">
            Отмеченные адаптеры — это пути, по которым защищённым программам будет закрыт ПРЯМОЙ выход в интернет.
            Проверь, что отмечено всё твоё сетевое железо: Wi-Fi, Ethernet, LTE-модем, Bluetooth-тетеринг.
            Пропущенный адаптер = дыра в защите. Отмеченный VPN-адаптер = программа потеряет интернет и с включённым VPN.
        </TextBlock>

        <TextBlock Grid.Row="1" x:Name="WarningText" TextWrapping="Wrap" FontSize="12"
                   Foreground="#B34700" Margin="0,0,0,10" Visibility="Collapsed" />

        <ListBox Grid.Row="2" x:Name="AdapterList" BorderBrush="#DDD" BorderThickness="1"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4,6" VerticalContentAlignment="Center">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Foreground="#555" TextWrapping="Wrap">
                                <Run Text="{Binding Description, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#7A828E" TextWrapping="Wrap">
                                <Run Text="{Binding Details, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#7A828E"
                       Text="Приложение предлагает отметку по типу адаптера: реальное сетевое железо — отмечено, VPN-туннели и виртуальные адаптеры — нет. Если твой VPN-клиент ставит адаптер, похожий на обычный Ethernet, сними с него отметку вручную." />
            <Border Background="#FFF6E6" BorderBrush="#E0C580" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#5B4A20">
                    <Run FontWeight="SemiBold" Text="Если после применения интернет пропадёт." />
                    <Run Text="Кнопка «Отключить защиту» на вкладке «Защищённые приложения» снимает все правила. Если приложение не открывается — запусти" />
                    <Run FontFamily="Consolas" Text="tools\remove-protection.bat" />
                    <Run Text="из папки приложения: он сам попросит права администратора и снимет правила." />
                </TextBlock>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="Отмена" Width="120" Height="30" Margin="0,0,10,0"
                    IsCancel="True" Click="CancelButton_Click" />
            <Button x:Name="ConfirmButton" Content="Применить с этим списком" Width="200" Height="30"
                    IsDefault="True" Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Window>
